---
import type { ImageMetadata } from 'astro';
import { homeCardImage } from '../data/canvasser';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import loggerCard from '../assets/logger/card.png';

const cardImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/canvasser/*.{png,jpg,jpeg}',
  { eager: true },
);
const cardImage = homeCardImage.alt.trim()
  ? cardImages[`../assets/canvasser/${homeCardImage.file}`]?.default
  : undefined;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nomaan Akram',
  jobTitle: 'UX and Product Designer',
  url: 'https://nomaan-akram.pages.dev/',
  address: { '@type': 'PostalAddress', addressLocality: 'Bristol', addressCountry: 'GB' },
  sameAs: [
    'https://www.linkedin.com/in/nomaan-akram-b35565223/',
    'https://github.com/nomaan02',
  ],
};
---

<BaseLayout
  title="Nomaan Akram · UX and Product Designer in Bristol"
  description="UX and Product Designer in Bristol. 4 years at Barclays, founder of NakoLabs, and the designer and builder of a field app used daily by 60+ canvassers."
>
  <script type="application/ld+json" set:html={JSON.stringify(person)} slot="head" />

  <section class="hero container" aria-labelledby="hero-title">
    <p class="eyebrow">UX and Product Designer · Bristol</p>
    <h1 id="hero-title">Hi, I'm Nomaan.</h1>
    <p class="tagline">
      I research, design, build and ship <span class="tagline__aside">(and everything in between)</span>.
    </p>
    <p class="lead">
      I spent 4 years designing at Barclays, and since 2021 I've run NakoLabs, my studio for design, dev and motion. Right now I lead and coach a door-to-door sales team in Bristol, and I designed and built the app they run on.
    </p>
    <p class="lead">
      By night, I'm a 3D and motion design freelancer (as well as an enthusiast). I work in Blender, Cinema 4D and After Effects, and designing promo for my own live music events is what grew NakoLabs to 100+ projects over the last 5 years.
    </p>
    <div class="actions">
      <a class="button" href="/work/canvasser/">Read the case study</a>
      <a class="button button--secondary" href="mailto:nomaanakram4@gmail.com">Email me</a>
    </div>
  </section>

  <Section id="work" eyebrow="Work" title="Selected work">
    <ProjectCard
      featured
      headingLevel={3}
      image={cardImage}
      imageAlt={cardImage ? homeCardImage.alt : undefined}
      meta="First Home Improvements · 2026"
      title="D2D: from paper surveys to live data"
      summary="I knocked doors on this team, then designed and built the app it now runs on. Used daily by 60+ canvassers across 5 South West branches."
      tags={['Field research', 'UX/UI', 'Offline-first', 'Next.js', 'Supabase']}
      href="/work/canvasser/"
      linkLabel="Read the case study"
    />
    <div class="feature-gap">
      <ProjectCard
        featured
        headingLevel={3}
        image={loggerCard}
        imageAlt="The D2D Logger before and after: V1 with four outcome buttons down the right edge, and V2.1 with one outcome dial under the thumb."
        meta="Design deep-dive · D2D · 2026"
        title="One thumb, one mark per door"
        summary="Tap heatmaps from five canvassers showed the Logger's buttons sat in the thumb's stretch zone. The research, three design passes and the press, drag and release gesture that replaced them."
        tags={['Field research', 'Interaction design', 'Figma', 'Accessibility']}
        href="/work/canvasser/logger/"
        linkLabel="Read the deep-dive"
      />
    </div>
    <div class="card-grid">
      <ProjectCard
        meta="Case study · QuantTrader · 2026"
        title="Running AI agents on a trading platform"
        summary="How I ran AI agents on a futures platform I built with a business partner: one job per model, pinned context, two human approval gates, and no agent ever near the broker keys."
        tags={['AI agents', 'Claude Code', 'MCP', 'Python']}
        href="/work/ai-workflow/"
        linkLabel="Read the case study"
      />
      <ProjectCard
        meta="Barclays · 2022-2026"
        title="UX / Product Designer"
        summary="4 years across Business Banking, Customer Care and Transact & Pay. I led the Premier offers onboarding flow end to end, and redesigned a CHAPS outage banner that lifted link success by 30% in testing."
        tags={['User research', 'UserZoom', 'Figma', 'Design systems']}
      />
      <ProjectCard
        meta="Client · Everlink"
        title="NFC jewellery store"
        summary="A Shopify store, plus a separate site where each piece links to its owner's personal page through an NFC tag. Designs and a proof of concept delivered. The project is paused."
        tags={['Shopify', 'Figma', 'APIs and webhooks']}
        href="https://github.com/nomaan02/everlink-nfc-commerce"
        linkLabel="View on GitHub"
      />
      <ProjectCard
        meta="Client · Looptech"
        title="Shopify storefront"
        summary="Ongoing Shopify work. I built the Brand New and Renewed toggle, product filtering and a Smart Pick recommendation, with prices and details updating as you choose."
        tags={['Shopify', 'Liquid', 'TypeScript']}
      />
      <ProjectCard
        meta="Personal tool"
        title="VoxPrompt"
        summary="A voice-to-prompt tool I built and use every day."
        href="https://github.com/nomaan02/voxprompt"
        linkLabel="View on GitHub"
      />
      <ProjectCard
        meta="Personal tool"
        title="CISI revision hub"
        summary="A revision app for the CISI finance exams."
        href="https://github.com/nomaan02/cisi-revision-hub"
        linkLabel="View on GitHub"
      />
    </div>
  </Section>

  <Section id="about" eyebrow="About" title="A designer who builds" tone="surface">
    <div class="about">
      <p>
        I'm a UX and Product Designer in Bristol. I spent 4 years on the UX team at Barclays through a degree apprenticeship with Manchester Metropolitan University, shipping 2 to 3 projects and dev handovers a month.
      </p>
      <p>
        I've coded since I was 13, so I work close to developers. At Barclays I built a design-to-dev handover framework that two teams adopted, and I ran a weekly design crit for 30 to 40 designers.
      </p>
      <p>
        Since 2021 I've run NakoLabs, a small studio for design, dev and 3D motion, with 100+ projects for 30+ clients.
      </p>
    </div>
    <div class="actions">
      <a class="button" href="mailto:nomaanakram4@gmail.com">Email me</a>
      <a class="button button--secondary" href="https://github.com/nomaan02">GitHub</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-7);
  }

  .hero h1 {
    max-width: 18ch;
    margin-top: var(--space-3);
  }

  .tagline {
    max-width: none;
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .tagline__aside {
    font-size: 0.7em;
    font-weight: var(--weight-regular);
    font-style: italic;
    letter-spacing: 0;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .lead + .lead {
    margin-top: var(--space-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .feature-gap {
    margin-top: var(--space-5);
  }

  .card-grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: var(--space-9);
    }

    .card-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
