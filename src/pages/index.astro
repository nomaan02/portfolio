---
import type { ImageMetadata } from 'astro';
import { homeCardImage } from '../data/canvasser';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';

const cardImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/canvasser/*.{png,jpg,jpeg}',
  { eager: true },
);
const cardImage = homeCardImage.alt.trim()
  ? cardImages[`../assets/canvasser/${homeCardImage.file}`]?.default
  : undefined;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nomaan Akram',
  jobTitle: 'UX and Product Designer',
  url: 'https://nomaan-akram.pages.dev/',
  address: { '@type': 'PostalAddress', addressLocality: 'Bristol', addressCountry: 'GB' },
  sameAs: [
    'https://www.linkedin.com/in/nomaan-akram-b35565223/',
    'https://github.com/nomaan02',
  ],
};
---

<BaseLayout
  title="Nomaan Akram · UX and Product Designer in Bristol"
  description="UX and Product Designer in Bristol. 4 years at Barclays, founder of NakoLabs, and the designer and builder of a field app used daily by 60+ canvassers."
>
  <script type="application/ld+json" set:html={JSON.stringify(person)} slot="head" />

  <section class="hero container" aria-labelledby="hero-title">
    <p class="eyebrow">UX and Product Designer · Bristol</p>
    <h1 id="hero-title">I design products, then I build them.</h1>
    <p class="lead">
      4 years designing at Barclays, and since 2021 running NakoLabs, a small studio for design, dev and motion. Most recently I knocked doors for a sales team, then designed and built the app they now run on.
    </p>
    <div class="actions">
      <a class="button" href="/work/canvasser/">Read the case study</a>
      <a class="button button--secondary" href="/nomaan-akram-cv.pdf">Download CV (PDF)</a>
    </div>
  </section>

  <Section id="work" eyebrow="Work" title="Selected work">
    <ProjectCard
      featured
      headingLevel={3}
      image={cardImage}
      imageAlt={cardImage ? homeCardImage.alt : undefined}
      meta="First Home Improvements · 2026"
      title="D2D: from paper surveys to live data"
      summary="I knocked doors on this team, then designed and built the app it now runs on. Used daily by 60+ canvassers across 5 South West branches."
      tags={['Field research', 'UX/UI', 'Offline-first', 'Next.js', 'Supabase']}
      href="/work/canvasser/"
      linkLabel="Read the case study"
    />
    <div class="card-grid">
      <ProjectCard
        meta="Barclays · 2022-2026"
        title="UX Designer"
        summary="4 years across Business Banking, Customer Care and Transact & Pay. I led the Premier offers onboarding flow end to end, and redesigned a CHAPS outage banner that lifted link success by 90% in testing."
        tags={['User research', 'UserZoom', 'Figma', 'Design systems']}
      />
      <ProjectCard
        meta="Client · Everlink"
        title="NFC jewellery store"
        summary="A Shopify store, plus a separate site where each piece links to its owner's personal page through an NFC tag. Designs and a proof of concept delivered. The project is paused."
        tags={['Shopify', 'Figma', 'APIs and webhooks']}
        href="https://github.com/nomaan02/everlink-nfc-commerce"
        linkLabel="View on GitHub"
      />
      <ProjectCard
        meta="Client · Looptech"
        title="Shopify storefront"
        summary="Ongoing Shopify work. I built the Brand New and Renewed toggle, product filtering and a Smart Pick recommendation, with prices and details updating as you choose."
        tags={['Shopify', 'Liquid', 'TypeScript']}
      />
      <ProjectCard
        meta="Side project · with a business partner"
        title="QuantTrader architecture"
        summary="The data pipeline behind a trading platform I'm building with a partner, including a local LLM layer for analysis."
        tags={['React', 'Ollama']}
        href="https://github.com/nomaan02/quanttrader-architecture"
        linkLabel="View on GitHub"
      />
      <ProjectCard
        meta="Personal tool"
        title="VoxPrompt"
        summary="A voice-to-prompt tool I built and use every day."
        href="https://github.com/nomaan02/voxprompt"
        linkLabel="View on GitHub"
      />
      <ProjectCard
        meta="Personal tool"
        title="CISI revision hub"
        summary="A revision app for the CISI finance exams."
        href="https://github.com/nomaan02/cisi-revision-hub"
        linkLabel="View on GitHub"
      />
    </div>
  </Section>

  <Section id="about" eyebrow="About" title="A designer who builds" tone="surface">
    <div class="about">
      <p>
        I'm a UX and Product Designer in Bristol. I spent 4 years on the UX team at Barclays through a degree apprenticeship with Manchester Metropolitan University, shipping 2 to 3 projects and dev handovers a month.
      </p>
      <p>
        I've coded since I was 13, so I work close to developers. At Barclays I built a design-to-dev handover framework that two teams adopted, and I ran a weekly design crit for 30 to 40 people.
      </p>
      <p>
        Since 2021 I've run NakoLabs, a small studio for design, dev and 3D motion, with 100+ projects for 30+ clients.
      </p>
    </div>
    <div class="actions">
      <a class="button" href="/nomaan-akram-cv.pdf">Download CV (PDF)</a>
      <a class="button button--secondary" href="mailto:nomaanakram4@gmail.com">Email me</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-7);
  }

  .hero h1 {
    max-width: 18ch;
    margin-top: var(--space-3);
  }

  .lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .card-grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: var(--space-9);
    }

    .card-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
