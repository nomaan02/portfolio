---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found · Nomaan Akram"
  description="This page doesn't exist on Nomaan Akram's portfolio."
>
  <meta name="robots" content="noindex" slot="head" />
  <section class="container">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist</h1>
    <p class="lead">The link may be out of date, or the address has a typo.</p>
    <div class="actions">
      <a class="button" href="/">Go to the homepage</a>
      <a class="button button--secondary" href="/work/canvasser/">Read the case study</a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    padding-top: var(--space-8);
    padding-bottom: var(--space-7);
  }

  h1 {
    margin-top: var(--space-3);
  }

  .lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (min-width: 48rem) {
    .container {
      padding-top: var(--space-9);
    }
  }
</style>
