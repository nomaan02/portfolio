---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ChipList from './ChipList.astro';

// Chips on Home cards (site-5-02). Status chips carry a dot plus a word, so colour is never the only signal.
type ChipTone = 'live' | 'paused' | 'ongoing' | 'category';
type Chip = { label: string; tone: ChipTone };

type Props = {
  title: string;
  summary: string;
  meta?: string;
  chips?: Chip[];
  tags?: string[];
  href?: string;
  linkLabel?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  featured?: boolean;
  headingLevel?: 2 | 3;
};

const {
  title,
  summary,
  meta,
  chips,
  tags,
  href,
  linkLabel = 'Read more',
  image,
  imageAlt,
  featured = false,
  headingLevel = 3,
} = Astro.props;

if (image && !imageAlt) {
  throw new Error('ProjectCard: imageAlt is required when image is set.');
}

const Heading = headingLevel === 2 ? 'h2' : 'h3';
const sizes = featured ? '(min-width: 48rem) 60vw, 100vw' : '(min-width: 48rem) 50vw, 100vw';
const isStatus = (tone: ChipTone): boolean => tone !== 'category';
---

<article class:list={['card', featured && 'card--featured', image && 'card--has-image', href && 'card--link']}>
  {
    image && imageAlt && (
      <div class="card__media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800, 1200]}
          sizes={sizes}
          format="webp"
          class="card__img"
        />
      </div>
    )
  }
  <div class="card__body">
    {
      (chips || meta) && (
        <div class="card__top">
          {chips && (
            <ul class="card__chips" aria-label="Status and type">
              {chips.map((chip) => (
                <li class:list={['chip', `chip--${chip.tone}`]}>
                  {isStatus(chip.tone) && <span class="chip__dot" aria-hidden="true" />}
                  {chip.label}
                </li>
              ))}
            </ul>
          )}
          {meta && <p class="card__meta">{meta}</p>}
        </div>
      )
    }
    <Heading class="card__title">
      {href ? <a href={href}>{title}</a> : title}
    </Heading>
    <p class="card__summary">{summary}</p>
    {tags && <ChipList items={tags} label={`${title} tools`} />}
    {href && <span class="card__cue" aria-hidden="true">{linkLabel} →</span>}
  </div>
</article>

<style>
  /* site-5-02: solid card on the dot grid. 1px border first, then a soft shadow (light) or edge light (dark). */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  /* Screenshots have light UI baked in, so they sit in a sunken well with their own frame. */
  .card__media {
    padding: var(--space-4);
    background-color: var(--color-sunken);
    border-bottom: 1px solid var(--color-border);
  }

  .card :global(.card__img) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-5);
  }

  @media (min-width: 48rem) {
    .card__media {
      padding: var(--space-5);
    }

    .card__body {
      padding: var(--space-6);
    }
  }

  .card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    max-width: none;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-full);
    background-color: var(--color-tint);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chip--live {
    background-color: var(--color-good-bg);
    color: var(--color-good);
  }

  .chip--paused {
    background-color: var(--color-warn-bg);
    color: var(--color-warn);
  }

  .chip__dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: currentColor;
  }

  .card__meta {
    max-width: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .card__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .card__title a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .card--link .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__summary {
    color: var(--color-text-muted);
  }

  .card__cue {
    margin-top: auto;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .card--link:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-lift);
  }

  .card--link:hover .card__cue {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card--link:has(a:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card--link {
      transition:
        border-color var(--duration-fast),
        box-shadow var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out);
    }

    .card--link:hover {
      transform: translateY(-2px);
    }
  }

  @media (min-width: 48rem) {
    .card--featured.card--has-image {
      display: grid;
      grid-template-columns: 3fr 2fr;
    }

    .card--featured .card__media {
      display: flex;
      align-items: center;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }

    .card--featured .card__body {
      justify-content: center;
    }

    .card--featured .card__cue {
      margin-top: var(--space-2);
    }

    .card--featured .card__title {
      font-size: var(--text-2xl);
    }
  }

  .card--featured:not(.card--has-image) .card__summary {
    max-width: var(--measure);
  }
</style>
