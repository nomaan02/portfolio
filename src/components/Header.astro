<style>
  header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--tap-min);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  nav {
    flex-shrink: 0;
  }

  ul {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  li {
    max-width: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  /* Theme toggle (site-5-01). A real button: aria-pressed is true when dark is on. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-border-strong);
    background-color: var(--color-sunken);
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle {
      transition:
        border-color var(--duration-fast),
        background-color var(--duration-fast);
    }
  }

  /* No JS, no theme switching: hide the button rather than show one that does nothing. */
  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }

  .theme-toggle__icon--sun,
  :global(:root[data-theme='dark']) .theme-toggle__icon--moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--sun {
    display: block;
  }
</style>
