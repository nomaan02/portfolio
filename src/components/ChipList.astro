---
type Props = {
  items: string[];
  label?: string;
};

const { items, label } = Astro.props;
---

<ul class="chips" aria-label={label}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  /* site-5-02: tool tags are quiet mono labels, so status chips on cards stand out. */
  .chips li {
    max-width: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.125rem var(--space-2);
  }
</style>
