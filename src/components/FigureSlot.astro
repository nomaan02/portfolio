---
import type { ImageMetadata } from 'astro';
import Figure from './Figure.astro';

type Props = {
  file: string;
  image?: ImageMetadata;
  alt: string;
  caption?: string;
  layout?: 'full' | 'narrow' | 'aside';
  text?: string;
  priority?: boolean;
};

const { file, image, alt, caption, text, layout = 'full', priority = false } = Astro.props;
const ready = Boolean(image) && alt.trim().length > 0;
const showPlaceholder = !ready && import.meta.env.DEV;
---

{
  ready && image && layout !== 'aside' && (
    <div class:list={['slot', `slot--${layout}`]}>
      <Figure image={image} alt={alt} caption={caption || undefined} priority={priority} />
    </div>
  )
}
{
  ready && image && layout === 'aside' && (
    <div class="slot slot--aside">
      <div class="slot__text">
        {text && <p class="slot__lead">{text}</p>}
        {caption && <p class="slot__note">{caption}</p>}
      </div>
      <div class="slot__media">
        <Figure image={image} alt={alt} priority={priority} />
      </div>
    </div>
  )
}
{
  showPlaceholder && (
    <div class:list={['slot', `slot--${layout}`, 'slot--empty']} aria-hidden="true">
      <p>Image slot</p>
      <code>src/assets/canvasser/{file}</code>
      <p>{image ? 'File found. Add alt text in src/data/canvasser.ts' : 'Add this file to show it'}</p>
    </div>
  )
}

<style>
  .slot--narrow {
    max-width: 32rem;
  }

  .slot--aside {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-md) + var(--space-2));
  }

  .slot__text {
    display: grid;
    gap: var(--space-3);
  }

  .slot__lead {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  .slot__note {
    margin: 0;
    color: var(--color-text-muted);
  }

  .slot__media {
    width: 100%;
    max-width: 22rem;
  }

  @media (min-width: 48rem) {
    .slot--aside {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: var(--space-7);
    }

    .slot__media {
      justify-self: end;
    }
  }

  .slot--empty {
    display: grid;
    place-content: center;
    gap: var(--space-2);
    min-height: 12rem;
    padding: var(--space-5);
    border: 2px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .slot--empty p {
    margin: 0;
    max-width: none;
  }
</style>
