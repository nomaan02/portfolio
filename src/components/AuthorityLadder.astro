---
import type { Level } from '../data/ai-workflow';

type Props = {
  label: string;
  levels: Level[];
  caption?: string;
};

const { label, levels, caption } = Astro.props;
---

<figure class="ladder">
  <p class="eyebrow">{label}</p>
  <p class="ladder__hint">Highest authority first</p>
  <ol class="ladder__list">
    {
      levels.map((level, i) => (
        <li class={`ladder__item ladder__item--${i + 1}`} style={`--i: ${i}`}>
          <span class="ladder__num tabular">{String(i + 1).padStart(2, '0')}</span>
          <span class="ladder__title">{level.title}</span>
          <span class="ladder__body">{level.body}</span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ladder {
    margin: 0;
    min-width: 0;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  @media (min-width: 48rem) {
    .ladder {
      padding: var(--space-6);
    }
  }

  .ladder__hint {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .ladder__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .ladder__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    width: 100%;
    max-width: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text);
  }

  .ladder__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .ladder__title {
    font-weight: var(--weight-semibold);
  }

  .ladder__body {
    grid-column: 2;
    font-size: var(--text-sm);
  }

  /* Colour steps from the accent token. Levels 1 and 2 carry white text (8.2:1 and 5.0:1). */
  .ladder__item--1 {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .ladder__item--2 {
    background-color: color-mix(in srgb, var(--color-accent) 80%, white);
    color: var(--color-on-accent);
  }

  .ladder__item--3 {
    background-color: color-mix(in srgb, var(--color-accent) 40%, white);
  }

  .ladder__item--4 {
    background-color: color-mix(in srgb, var(--color-accent) 22%, white);
  }

  .ladder__item--5 {
    background-color: var(--color-surface);
  }

  .ladder__item--6 {
    background-color: var(--color-bg);
    border-color: var(--color-border-strong);
  }

  figcaption {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .ladder__item {
      grid-template-columns: 2.5rem 11rem 1fr;
      align-items: baseline;
      width: calc(100% - var(--i) * 7%);
    }

    .ladder__body {
      grid-column: 3;
    }
  }
</style>
