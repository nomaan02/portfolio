---
type Props = {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'default' | 'surface';
};

const { id, eyebrow, title, intro, tone = 'default' } = Astro.props;

const slug = title
  .toLowerCase()
  .trim()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');

const headingId = id ? `${id}-title` : slug;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['section', 'reveal', tone === 'surface' && 'section--surface']}
>
  <div class="container">
    <div class:list={[tone === 'surface' && 'section__frame']}>
      <div class="section__head">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id={headingId}>{title}</h2>
        {intro && <p class="intro">{intro}</p>}
      </div>
      <div class="section__body">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-7);
  }

  @media (min-width: 48rem) {
    .section {
      padding-block: var(--space-9);
    }
  }

  /* site-5-01: "surface" sections are outlined artboards on the dot grid. No fill, a 1px frame. */
  .section__frame {
    padding: var(--space-6) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (min-width: 48rem) {
    .section__frame {
      padding: var(--space-7);
    }
  }

  .section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section__body {
    margin-top: var(--space-6);
  }

  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
