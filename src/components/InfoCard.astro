---
type Props = {
  eyebrow?: string;
  title: string;
  body: string;
  headingLevel?: 3 | 4;
};

const { eyebrow, title, body, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 4 ? 'h4' : 'h3';
---

<article class="info">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading>{title}</Heading>
  <p>{body}</p>
</article>

<style>
  .info {
    min-width: 0;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  @media (min-width: 48rem) {
    .info {
      padding: var(--space-6);
    }
  }

  .info :global(h3),
  .info :global(h4) {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .info > .eyebrow + :global(h3),
  .info > .eyebrow + :global(h4) {
    margin-top: var(--space-2);
  }

  .info > :global(h3) + p,
  .info > :global(h4) + p {
    margin-top: var(--space-2);
  }
</style>
