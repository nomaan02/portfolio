---
import type { Bar } from '../data/ai-workflow';

type Props = {
  label: string;
  bars: Bar[];
  caption?: string;
};

const { label, bars, caption } = Astro.props;
const max = Math.max(...bars.map((b) => b.value));
---

<figure class="chart">
  <p class="eyebrow">{label}</p>
  <ol class="chart__list">
    {
      bars.map((bar) => (
        <li class="chart__item" style={`--pct: ${Math.round((bar.value / max) * 100)}%; --frac: ${(bar.value / max).toFixed(3)}`}>
          <span class="chart__col">
            <span class="chart__value tabular">{bar.value}</span>
            <span class="chart__bar" aria-hidden="true" />
          </span>
          <span class="chart__label">{bar.label}</span>
          <span class="chart__note">{bar.note}</span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart {
    margin: 0;
    min-width: 0;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .chart__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  /* Small screens: horizontal bars */
  .chart__item {
    display: grid;
    grid-template-columns: 5.5rem 1fr 3rem;
    grid-template-areas:
      'label track value'
      'note note note';
    align-items: center;
    gap: var(--space-1) var(--space-3);
    max-width: none;
  }

  .chart__label {
    grid-area: label;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .chart__col {
    display: contents;
  }

  .chart__bar {
    grid-area: track;
    display: block;
    width: var(--pct);
    height: 1.25rem;
    background-color: var(--color-accent);
    border-radius: 0 4px 4px 0;
  }

  .chart__value {
    grid-area: value;
    font-weight: var(--weight-semibold);
    text-align: right;
  }

  .chart__note {
    grid-area: note;
    font-size: var(--text-sm);
  }

  figcaption {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Wider screens: vertical bars on one baseline */
  @media (min-width: 48rem) {
    .chart {
      padding: var(--space-6);
    }

    .chart__list {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .chart__item {
      grid-template-columns: 1fr;
      grid-template-rows: 16rem auto auto;
      grid-template-areas: 'col' 'label' 'note';
      align-items: start;
      align-content: start;
      gap: var(--space-2);
    }

    .chart__col {
      grid-area: col;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: var(--space-2);
      height: 100%;
    }

    .chart__value {
      text-align: left;
      font-size: var(--text-xl);
    }

    .chart__bar {
      width: 100%;
      height: calc((100% - 2.5rem) * var(--frac));
      border-radius: 4px 4px 0 0;
    }

    .chart__note {
      align-self: start;
    }
  }
</style>
